---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSearchIndex, loadSourcesHealth } from '../lib/data';
import { POLE_LABELS, UI_TEXT } from '../lib/i18n';

const indexData = loadSearchIndex();
const sourceHealth = loadSourcesHealth();
const sourcesCount = sourceHealth.operationalCount;
const polesEntries = Object.entries(POLE_LABELS);
const recentItems = [...indexData.items]
  .sort((a, b) => (b.score_pertinence || 0) - (a.score_pertinence || 0))
  .slice(0, 6);

const updatedFormatted = indexData.updated_at
  ? indexData.updated_at.slice(0, 10)
  : '2026-11-26';
---

<BaseLayout title="Accueil" activeNav="home">
  <section class="hero card">
    <div>
      <span class="badge" data-i18n="heroBadge">{UI_TEXT.fr.heroBadge}</span>
      <h1 data-i18n="heroTitle">{UI_TEXT.fr.heroTitle}</h1>
      <p class="hero-desc" data-i18n="heroDesc">{UI_TEXT.fr.heroDesc}</p>
      <div class="hero-actions">
        <a href="/veille" class="btn-primary" data-i18n="ctaWatch">{UI_TEXT.fr.ctaWatch}</a>
        <a href="/academy" class="btn-secondary" data-i18n="ctaAcademy">{UI_TEXT.fr.ctaAcademy}</a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-box">
        <strong>{indexData.total}</strong>
        <span data-i18n="statTotal">{UI_TEXT.fr.statTotal}</span>
      </div>
      <div class="stat-box">
        <strong>6</strong>
        <span data-i18n="statPoles">{UI_TEXT.fr.statPoles}</span>
      </div>
      <div class="stat-box">
        <strong>{sourcesCount}</strong>
        <span data-i18n="statSources">{UI_TEXT.fr.statSources}</span>
      </div>
      <div class="stat-box">
        <strong>{updatedFormatted}</strong>
        <span data-i18n="statUpdated">{UI_TEXT.fr.statUpdated}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2 data-i18n="polesTitle">{UI_TEXT.fr.polesTitle}</h2>
        <p class="muted" data-i18n="polesSubtitle">{UI_TEXT.fr.polesSubtitle}</p>
      </div>
    </div>

    <div class="poles-grid">
      {polesEntries.map(([key, labels]) => {
        const count = indexData.items.filter((i) => i.pole === key).length;
        return (
          <a href={`/veille?pole=${encodeURIComponent(key)}`} class="card pole-card">
            <span class="pole-count">{count}</span>
            <h3 data-fr={labels.fr} data-ar={labels.ar}>{labels.fr}</h3>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-i18n="recentTitle">{UI_TEXT.fr.recentTitle}</h2>
      <a href="/bibliotheque" class="btn-secondary" data-i18n="viewAll">{UI_TEXT.fr.viewAll}</a>
    </div>

    <div class="docs-grid">
      {recentItems.map((item) => (
        <article class="card doc-card">
          <div class="doc-meta">
            <span class="badge" data-fr={POLE_LABELS[item.pole]?.fr || item.pole} data-ar={POLE_LABELS[item.pole]?.ar || item.pole}>
              {POLE_LABELS[item.pole]?.fr || item.pole}
            </span>
            <span class="badge badge-score">Score {item.score_pertinence}</span>
          </div>
          <h3>
            <a href={`/fiche?id=${encodeURIComponent(item.id)}`}>{item.titre_original}</a>
          </h3>
          <p class="doc-sub">
            {item.source_nom} • {item.date_publication || 'N/A'} • {item.langue_originale.toUpperCase()}
          </p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.8rem;
    align-items: center;
    padding: 2rem;
  }

  .hero h1 {
    margin: 0.75rem 0 0.6rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.18;
  }

  .hero-desc {
    color: var(--muted);
    margin: 0 0 1.35rem;
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }

  .stat-box {
    background: var(--surface-alt);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-box strong {
    font-size: 1.35rem;
    color: var(--primary-dark);
  }

  .stat-box span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .section {
    margin-top: 2.5rem;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
    flex-wrap: wrap;
  }

  .section-head h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .muted {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .poles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .pole-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .pole-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
  }

  .pole-count {
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--primary);
  }

  .pole-card h3 {
    margin: 0;
    font-size: 1rem;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .doc-card h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  .doc-card h3 a:hover {
    color: var(--primary);
  }

  .doc-sub {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .poles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .docs-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .poles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
